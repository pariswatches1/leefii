# Leefii Environment Variables
# Copy this file to .env and fill in your values

# Database Connection (DigitalOcean PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://doadmin:YOUR_PASSWORD@YOUR_HOST:25060/defaultdb?sslmode=require"

# Site URL (used for SEO and canonical URLs)
NEXT_PUBLIC_SITE_URL="https://leefii.com"

# NextAuth.js Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Optional: Admin setup key (change this in production)
ADMIN_SETUP_KEY="leefii-admin-setup-2026"

# Optional: Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Places API (for finding MMJ doctors)
GOOGLE_PLACES_API_KEY="your-google-places-api-key"

# IndexNow (instant search engine indexing)
INDEXNOW_KEY="your-indexnow-key"
INDEXNOW_SECRET="your-indexnow-secret"

# Resend Email Service (https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
